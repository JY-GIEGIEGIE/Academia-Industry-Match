# ============================================================
# 本地开发环境模板（入库）
# 使用方法：复制为 .env，填入真实值；.env 已在 .gitignore 中
# 不要把真实 key / 密码写进本文件，也不要提交到仓库
# ============================================================

# ---------- 百炼 / DashScope ----------
DASHSCOPE_API_KEY=sk-your-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ---------- 模型契约（变更需 bump EMBEDDING_MODEL_VERSION）----------
QWEN_CHAT_MODEL=qwen3.8-flash
QWEN_EXTRACT_MODEL=qwen3.8-flash
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIM=1024
EMBEDDING_MODEL_VERSION=qwen3.7-text-embedding-flash-1024-v1
RERANK_MODEL=qwen3.7-text-rerank

# ---------- PostgreSQL 16 + pgvector ----------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=s2_mvp_20261125
POSTGRES_USER=aim
POSTGRES_PASSWORD=change-me-local-dev
DATABASE_URL=postgresql://aim:change-me-local-dev@127.0.0.1:5432/s2_mvp_20261125

# ---------- Redis / Celery ----------
# 宿主机访问用 127.0.0.1；compose 内 worker 用 redis://redis:6379
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ---------- OpenAlex（可选）----------
OPENALEX_MAILTO=
OPENALEX_API_KEY=

# ---------- FastAPI / JWT Authentication ----------
JWT_SECRET=your_generated_secret
